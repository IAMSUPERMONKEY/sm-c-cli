{
  "name": "sm-c-cli",
  "version": "0.1.0",
  "description": "Supermonkey C-end CLI for class schedule queries.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "deepfunc <xiekai0601@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@codeup.aliyun.com/supermonkey/supermonkey-web/sm-c-cli.git"
  },
  "bin": {
    "sm-c-cli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.3",
  "volta": {
    "node": "22.16.0"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
