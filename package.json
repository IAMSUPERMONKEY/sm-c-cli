{
  "name": "sm-c-cli",
  "version": "1.1.0",
  "description": "SUPERMONKEY 官方 CLI",
  "type": "module",
  "license": "MIT",
  "author": "deepfunc <xiekai0601@gmail.com>",
  "homepage": "https://github.com/IAMSUPERMONKEY/sm-c-cli#readme",
  "bugs": {
    "url": "https://github.com/IAMSUPERMONKEY/sm-c-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAMSUPERMONKEY/sm-c-cli.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bin": {
    "sm-c-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "check": "npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "dependencies": {
    "axios": "^1.15.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md,mdx,css,scss,html}": "prettier --write"
  }
}
